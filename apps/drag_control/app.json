{
  "id": "drag_control",
  "name": "x58LC",
  "version": "1.0.1",
  "theme": "m_tricolour",
  "headerTabs": true,
  "pages": [
    {
      "id": "launch_tab",
      "title": "Launch Control",
      "buttons": [
        { "id": "btn_arm_lc", "label": "Arm LC Bypass", "action": "armLaunch" },
        { "id": "btn_disarm_lc", "label": "Release / Disarm", "action": "disarmLaunch" },
        { "id": "btn_toggle_safety", "label": "Toggle 10 PSI Auto-Cutoff", "action": "toggleSafety" },
        { "id": "btn_clear_dtc", "label": "Clear Drivetrain Faults", "action": "clearFaults" }
      ]
    },
    {
      "id": "xdrive_tab",
      "title": "xDrive / RWD",
      "buttons": [
        { "id": "btn_rwd", "label": "RWD (Burnout Mode)", "action": "setRwd" },
        { "id": "btn_awd", "label": "xDrive AWD (Launch)", "action": "setAwd" }
      ]
    }
  ],
  "settings": [
    {
      "id": "autoCutoffEnabled",
      "label": "10 PSI / 2.5s Auto-Cutoff",
      "type": "enum",
      "options": ["ON (Safe Mode)", "OFF (Manual Release Only)"],
      "default": "ON (Safe Mode)"
    },
    {
      "id": "boostCutoffPsi",
      "label": "Auto-Cutoff Boost Target",
      "type": "enum",
      "options": ["8 PSI", "10 PSI", "12 PSI", "15 PSI"],
      "default": "10 PSI"
    }
  ]
}
